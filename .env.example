# Variables d'environnement d'OTAGE. Copier ce fichier en .env.local pour travailler en local ;
# sur Vercel : Settings → Environment Variables. Aucune de ces valeurs ne doit être écrite dans le code.

# Adresse du script Google Apps Script qui enregistre les commandes dans le Google Sheet (se termine par /exec).
ORDERS_ENDPOINT=

# Clé API Resend (e-mails de confirmation). Sans clé, les commandes passent quand même : seul l'e-mail n'est pas envoyé.
RESEND_API_KEY=

# Adresse de la boutique qui reçoit la notification interne de chaque commande.
SHOP_EMAIL=

# Facultatif : expéditeur des e-mails (par défaut « OTAGE Cosmétiques <commandes@otage.ma> »).
# EMAIL_FROM=

# Facultatif : identifiant Google Analytics 4 (G-XXXXXXX). Sans lui, ni script ni bannière.
# NEXT_PUBLIC_GA_ID=
